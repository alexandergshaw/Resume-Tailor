# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# MediaPipe wasm runtime, staged at build time (scripts/copy-mediapipe.mjs)
# from the installed @mediapipe/tasks-vision package -- deliberately not
# committed, see public/mediapipe/models/README.md. The .task model files
# in that same models/ directory ARE committed and are not covered by this.
/public/mediapipe/wasm/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
